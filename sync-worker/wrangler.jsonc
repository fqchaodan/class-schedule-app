{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fanqie-schedule-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "routes": [
    {
      "pattern": "api.fqcdan1001.dpdns.org",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "class-schedule-db",
      "database_id": "927f59f2-c8d1-4ba1-839f-a7e6b51dd0c2"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SYNC_DATA",
      "id": "d1a30d0618ba4b8f8bab507352a21174"
    }
  ]
}
