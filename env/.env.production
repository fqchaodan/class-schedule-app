# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'production'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = true
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# 云同步接口地址：必须是国内可直连的入口。
# 原 https://api.fqcdan1001.dpdns.org 整段域名在国内被按 SNI 重置（TLS 握手即断），
# 现走 Cloudflare Pages 反代（源码 sync-worker/pages-proxy），由它在 CF 内网转发到原 Worker。
VITE_SYNC_SERVER_URL = 'https://fanqie-schedule-api.pages.dev'

# production mode 后台请求地址
# VITE_SERVER_BASEURL = 'https://prod.xxx.com'
